@model IEnumerable<VibeShoot.Models.Entities.Booking>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<link rel="stylesheet" href="~/css/Navbar.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Book.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />

<div class="vs-page">
    <div class="vs-bg-layer">
        <div class="vs-bokeh"></div>
        <div class="vs-bokeh blur"></div>
        <div class="vs-bokeh"></div>
    </div>
    <div class="vs-grain"></div>
    <div class="vs-vignette"></div>

    <nav class="vs-navbar" style="position: absolute; top:0; width: 100%; z-index: 10;">
        <a class="vs-nav-brand" href="#">VibeShoot Admin</a>
        <div class="vs-nav-links">
            <a class="vs-nav-link" href="@Url.Action("Logout", "Admin")">Logout</a>
        </div>
        <span></span>
    </nav>

    <div class="vs-dashboard-container">
        <!-- LEFT COLUMN: Calendar Panel -->
        <div class="vs-admin-panel">
            <h2 class="vs-title" style="text-align: center; margin-bottom: 5px;">Schedule Manager</h2>
            <p class="vs-subtitle" style="text-align: center;">Click on a Green date to block it. Click a Red date to unblock.</p>

            <div class="vs-legend" style="margin-bottom: 20px;">
                <div class="legend-item"><div class="legend-dot status-available"></div> Available</div>
                <div class="legend-item"><div class="legend-dot status-blocked"></div> Not Available</div>
                <div class="legend-item"><div class="legend-dot status-pending"></div> Pending</div>
                <div class="legend-item"><div class="legend-dot status-confirmed"></div> Confirmed</div>
            </div>

            <div class="vs-calendar">
                <div class="vs-calendar-header">
                    <button class="vs-calendar-btn" id="adminPrevMonth"><svg viewBox="0 0 24 24"><path d="M14.7 5.3 8 12l6.7 6.7 1.4-1.4L10.8 12l5.3-5.3z" /></svg></button>
                    <div class="vs-month-year" id="adminMonthYear"></div>
                    <button class="vs-calendar-btn" id="adminNextMonth"><svg viewBox="0 0 24 24"><path d="M9.3 5.3 16 12l-6.7 6.7-1.4-1.4L13.2 12 7.9 6.7z" /></svg></button>
                </div>
                <div class="vs-days-grid" id="adminCalendarGrid"></div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Booking Requests List -->
        <div class="vs-admin-panel scroll-panel">
            <h2 class="vs-form-title" style="margin-top: 0; color: var(--white);">Booking Requests</h2>

            @if (!Model.Any())
            {
                <p style="color: rgba(245,245,242,0.5);">No bookings found.</p>
            }

            <!-- Wrap bookings so JS can paginate them -->
            <div id="bookingListContainer">
                @foreach (var booking in Model)
                {
                    <div class="admin-booking-card">
                        <h3 style="margin: 0 0 5px; color: var(--white);">@booking.ClientName</h3>
                        <p style="margin: 0; font-size: 0.85rem; color: rgba(245,245,242,0.7);">
                            <strong>Date:</strong> @booking.TargetDate.ToString("MMM dd, yyyy") <br />
                            <strong>Status:</strong> <span style="color: @(booking.Status == "Pending" ? "#ffc107" : booking.Status == "Confirmed" ? "#007bff" : "#dc3545")">@booking.Status</span><br />
                            <strong>Package:</strong> @booking.PackageName <br />
                            <strong>TxID:</strong> @booking.TransactionId
                        </p>
                        <div style="margin-top: 10px; display: flex; gap: 10px;">

                            <!-- NEW: View Receipt Button that triggers the Modal -->
                            <button type="button" class="vs-submit-btn view-receipt-btn" data-img="@booking.ReceiptImagePath" style="padding: 5px 15px; font-size: 0.8rem; background: transparent; border: 1px solid rgb(201,162,39); color: rgb(201,162,39);">View Receipt</button>

                            @if (booking.Status == "Pending")
                            {
                                <form asp-action="UpdateStatus" method="post" style="margin: 0; flex:1;">
                                    <input type="hidden" name="transactionId" value="@booking.TransactionId" />
                                    <input type="hidden" name="status" value="Confirmed" />
                                    <button type="submit" class="vs-submit-btn" style="padding: 5px 15px; font-size: 0.8rem; background: #007bff; border-color: #007bff;">Confirm</button>
                                </form>
                                <form asp-action="UpdateStatus" method="post" style="margin: 0; flex:1;">
                                    <input type="hidden" name="transactionId" value="@booking.TransactionId" />
                                    <input type="hidden" name="status" value="Declined" />
                                    <button type="submit" class="vs-submit-btn" style="padding: 5px 15px; font-size: 0.8rem; background: #dc3545; border-color: #dc3545; color: white;">Decline</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- NEW: Pagination Controls container -->
            <div id="paginationControls" class="vs-pagination"></div>

        </div>
    </div>
</div>

<!-- NEW: Receipt Image Preview Modal -->
<div class="vs-receipt-modal" id="adminReceiptModal">
    <div class="vs-receipt-content">
        <button class="vs-receipt-close" id="closeReceiptModal">&times;</button>
        <img id="receiptPreviewImg" src="" alt="Client Receipt" />
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            // ==========================================
            // 1. RECEIPT PREVIEW MODAL LOGIC
            // ==========================================
            const receiptModal = document.getElementById('adminReceiptModal');
            const receiptImg = document.getElementById('receiptPreviewImg');
            const closeBtn = document.getElementById('closeReceiptModal');

            document.querySelectorAll('.view-receipt-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const imgSrc = this.getAttribute('data-img');
                    receiptImg.src = imgSrc;
                    receiptModal.classList.add('open');
                });
            });

            closeBtn.addEventListener('click', () => receiptModal.classList.remove('open'));
            receiptModal.addEventListener('click', (e) => {
                // Close if user clicks outside the image
                if (e.target === receiptModal) {
                    receiptModal.classList.remove('open');
                }
            });

            // ==========================================
            // 2. PAGINATION LOGIC (5 Items Per Page)
            // ==========================================
            const cards = document.querySelectorAll('.admin-booking-card');
            const itemsPerPage = 5;
            let currentPage = 1;
            const totalPages = Math.ceil(cards.length / itemsPerPage);
            const paginationContainer = document.getElementById('paginationControls');

            function showPage(page) {
                currentPage = page;
                const start = (page - 1) * itemsPerPage;
                const end = start + itemsPerPage;

                cards.forEach((card, index) => {
                    if (index >= start && index < end) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
                renderPaginationButtons();
            }

            function renderPaginationButtons() {
                paginationContainer.innerHTML = '';
                if (totalPages <= 1) return; // Don't show pagination if 5 or fewer items

                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button');
                    btn.className = `vs-page-btn ${i === currentPage ? 'active' : ''}`;
                    btn.innerText = i;
                    btn.addEventListener('click', () => showPage(i));
                    paginationContainer.appendChild(btn);
                }
            }

            // Initialize first page if there are cards
            if (cards.length > 0) {
                showPage(1);
            }

            // ==========================================
            // 3. CALENDAR LOGIC
            // ==========================================
            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

            let currentMonth = new Date().getMonth();
            let currentYear = new Date().getFullYear();
            let scheduleData = { bookings: [], blockedDates: [] };

            async function fetchSchedule() {
                const response = await fetch('/Admin/GetScheduleData');
                scheduleData = await response.json();
                renderCalendar(currentMonth, currentYear);
            }

            function getStatusClass(year, month, day) {
                const m = String(month + 1).padStart(2, '0');
                const d = String(day).padStart(2, '0');
                const dateString = `${year}-${m}-${d}`;

                if (scheduleData.blockedDates.some(b => b.date.startsWith(dateString))) return 'status-blocked';

                const booking = scheduleData.bookings.find(b => b.targetDate.startsWith(dateString));
                if (booking) {
                    if (booking.status === 'Pending') return 'status-pending';
                    if (booking.status === 'Confirmed') return 'status-confirmed';
                }
                return 'status-available';
            }

            async function toggleDate(year, month, day, currentStatus) {
                if(currentStatus === 'status-pending' || currentStatus === 'status-confirmed') return;

                const m = String(month + 1).padStart(2, '0');
                const d = String(day).padStart(2, '0');

                await fetch('/Admin/ToggleBlockDate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ date: `${year}-${m}-${d}` })
                });

                fetchSchedule();
            }

            function renderCalendar(month, year) {
                const grid = document.getElementById('adminCalendarGrid');
                const disp = document.getElementById('adminMonthYear');
                grid.innerHTML = "";
                disp.innerText = monthNames[month] + " " + year;

                dayNames.forEach(day => {
                    const header = document.createElement('div');
                    header.className = 'vs-day-name';
                    header.innerText = day;
                    grid.appendChild(header);
                });

                const firstDay = new Date(year, month, 1).getDay();
                const daysInMonth = new Date(year, month + 1, 0).getDate();

                for (let i = 0; i < firstDay; i++) {
                    grid.appendChild(document.createElement('div'));
                }

                for (let i = 1; i <= daysInMonth; i++) {
                    const cell = document.createElement('div');
                    const cellDate = new Date(year, month, i);

                    if (cellDate.setHours(0,0,0,0) < new Date().setHours(0,0,0,0)) {
                        cell.className = 'vs-day-cell disabled';
                    } else {
                        const statusClass = getStatusClass(year, month, i);
                        cell.className = `vs-day-cell ${statusClass}`;
                        cell.addEventListener('click', () => toggleDate(year, month, i, statusClass));
                    }

                    cell.innerHTML = `<span class="vs-day-number">${i}</span>`;
                    grid.appendChild(cell);
                }
            }

            document.getElementById('adminPrevMonth').addEventListener('click', () => {
                currentMonth--; if (currentMonth < 0) { currentMonth = 11; currentYear--; }
                renderCalendar(currentMonth, currentYear);
            });

            document.getElementById('adminNextMonth').addEventListener('click', () => {
                currentMonth++; if (currentMonth > 11) { currentMonth = 0; currentYear++; }
                renderCalendar(currentMonth, currentYear);
            });

            fetchSchedule();
        });
    </script>
}