@model List<VibeShoot.Models.PhotographerCard>
@{
    ViewData["Title"] = "Choose Your Photographer";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Details.css" asp-append-version="true" />
}

<div class="vs-iris-in" aria-hidden="true"></div>

<div class="vs-page">
    <div class="vs-bg-layer">
        <div class="vs-bokeh"></div>
        <div class="vs-bokeh blur"></div>
        <div class="vs-bokeh"></div>
    </div>
    <div class="vs-grain"></div>
    <div class="vs-vignette"></div>

    <div class="vs-select-content">
        <span class="vs-brandmark">VibeShoot</span>
        <h1 class="vs-select-title">Choose Your Photographer</h1>
        <p class="vs-select-sub">Pick the eye behind the lens for your shoot.</p>

        <div class="vs-photog-grid">
            @for (int i = 0; i < Model.Count; i++)
            {
                var c = Model[i];
                <a class="vs-photog-card"
                   href="/photographer/@c.Slug/about"
                   style="animation-delay:@((2 + i * 0.5).ToString(System.Globalization.CultureInfo.InvariantCulture))s"
                   aria-label="View @c.Name">
                    <span class="vs-photog-ring">
                        <img src="@c.LogoPath" alt="@c.Name logo" />
                    </span>
                    <span class="vs-photog-name">@c.Name</span>
                    @if (c.ReviewCount > 0)
                    {
                        <span class="vs-photog-rating" aria-label="@c.Rating.ToString("0.0") out of 5 stars from @c.ReviewCount reviews">
                            <b>★</b> @c.Rating.ToString("0.0") <small>(@c.ReviewCount)</small>
                        </span>
                    }
                    <span class="vs-photog-meta">
                        @(c.PhotoCount > 0 ? $"{c.PhotoCount} photos" : "Portfolio soon")
                        @if (c.StartingPrice != null) { <text> · from @Ui.Peso(c.StartingPrice.Value).Replace(".00", "")</text> }
                    </span>
                </a>
            }
        </div>

        <a class="vs-track-cta" href="/booking/track">Already booked? <b>Track your booking &rarr;</b></a>
        <a class="vs-privacy-link" href="/privacy">Privacy Notice</a>
    </div>
</div>

<div class="vs-iris" id="visIris" aria-hidden="true"></div>

@section Scripts {
    <script src="~/js/Details.js" asp-append-version="true"></script>
}