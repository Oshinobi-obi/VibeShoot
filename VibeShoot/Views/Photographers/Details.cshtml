@{
    ViewData["Title"] = "Choose Your Photographer";
    Layout = "_Layout";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/Details.css" asp-append-version="true" />

<div class="vs-iris-in" aria-hidden="true"></div>

<div class="vs-page">
    <div class="vs-bg-layer">
        <div class="vs-bokeh"></div>
        <div class="vs-bokeh blur"></div>
        <div class="vs-bokeh"></div>
    </div>
    <div class="vs-grain"></div>
    <div class="vs-vignette"></div>

    <div class="vs-select-content">
        <span class="vs-brandmark">VibeShoot</span>
        <h1 class="vs-select-title">Choose Your Photographer</h1>
        <p class="vs-select-sub">Pick the eye behind the lens for your shoot.</p>

        <div class="vs-photog-grid">
            <a class="vs-photog-card"
               href="/photographer/sulyap-films/about"
               style="animation-delay:2s"
               aria-label="View Sulyap Films">
                <span class="vs-photog-ring">
                    <img src="~/Uploads/Logos/SulyapFilms/SulyapFilms.png" alt="Sulyap Films logo" />
                </span>
                <span class="vs-photog-name">Sulyap Films</span>
            </a>

            <a class="vs-photog-card"
               href="/photographer/ginger-snaps/about"
               style="animation-delay:2.5s"
               aria-label="View Ginger Snaps Photography">
                <span class="vs-photog-ring">
                    <img src="~/Uploads/Logos/GingerSnaps/GingerSnaps.png" alt="Ginger Snaps Photography logo" />
                </span>
                <span class="vs-photog-name">Ginger Snaps Photography</span>
            </a>

            <a class="vs-photog-card"
               href="/photographer/chiyos-folder/about"
               style="animation-delay:3s"
               aria-label="View Chiyos Folder">
                <span class="vs-photog-ring">
                    <img src="~/Uploads/Logos/ChiyosFolder/ChiyosFolder.png" alt="Chiyos Folder logo" />
                </span>
                <span class="vs-photog-name">Chiyos Folder</span>
            </a>
        </div>
    </div>
</div>

<div class="vs-iris" id="visIris" aria-hidden="true"></div>

@section Scripts {
    <script src="~/js/Details.js" asp-append-version="true"></script>
}