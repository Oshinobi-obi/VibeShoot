@{
    ViewData["Title"] = "Welcome";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Index.css" asp-append-version="true" />
}

<div class="vs-hero">
    <div class="vs-bg-layer">
        <div class="vs-bokeh"></div>
        <div class="vs-bokeh blur"></div>
        <div class="vs-bokeh"></div>
        <div class="vs-bokeh blur"></div>
        <div class="vs-bokeh"></div>
        <div class="vs-bokeh blur"></div>
    </div>
    <div class="vs-grain"></div>
    <div class="vs-vignette"></div>

    <div class="vs-viewfinder">
        <span class="vs-bracket tl"></span>
        <span class="vs-bracket tr"></span>
        <span class="vs-bracket bl"></span>
        <span class="vs-bracket br"></span>
        <span class="vs-aperture-tag">VibeShoot</span>
    </div>

    <div class="vs-content">
        <h1 class="vs-logo">
            <span class="vs-chrome">V</span><span>I</span><span>B</span><span>E</span><span class="vs-chrome">S</span><span>H</span><span>O</span><span>O</span><span>T</span>
        </h1>
        <p class="vs-tagline">Your vision. Their lens. Perfect timing.<span class="vs-cursor"></span></p>
    </div>
</div>

<div class="vs-iris" id="visIris" aria-hidden="true"></div>

@section Scripts {
    <script src="~/js/Index.js" asp-append-version="true"></script>
}