@model VibeShoot.Models.ReceiptViewModel
@using VibeShoot.Models.Entities
@{
    Layout = null;
    var b = Model.Booking;
    var docNo = b.TransactionId;
    var visiblePayments = b.Payments.ToList();
    var dueNow = b.Balance - b.AmountForVerification;
    var canPayBalance = b.Status == BookingStatus.Confirmed && b.TotalPrice > 0 && dueNow > 0 && !string.IsNullOrEmpty(b.Photographer?.GCashQrPath);
    var token = Context.Request.Query["t"].ToString();
    var paySuccess = TempData["PaySuccess"] as string;
    var waiting = b.Status == BookingStatus.Pending;
    var fileName = $"VibeShoot-{docNo}.pdf";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Booking @docNo · VibeShoot</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Receipt.css" asp-append-version="true" />
</head>
<body class="rc">
    <div class="rc-toolbar">
        <a class="back" href="/photographer/@b.Photographer?.Slug/schedule">&larr; Back to @b.Photographer?.Name</a>
        <div class="group">
            <button class="rc-btn" id="btnPdf" type="button">
                <svg viewBox="0 0 24 24"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>Download PDF
            </button>
            <button class="rc-btn gold" type="button" onclick="window.print()">
                <svg viewBox="0 0 24 24"><path d="M7 9V3h10v6M7 18H5a1 1 0 0 1-1-1v-6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v6a1 1 0 0 1-1 1h-2M7 14h10v7H7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>Print
            </button>
        </div>
    </div>

    @if (paySuccess != null) { <div class="rc-flash ok">@paySuccess</div> }
    @if (waiting)
    {
        <div class="rc-flash notify" id="rcNotify" hidden>
            <span><b>Want a heads-up?</b> We'll notify you here when your session is confirmed.</span>
            <button type="button" class="rc-btn gold" id="rcNotifyBtn">Notify me</button>
        </div>
    }
    @if (TempData["PayError"] != null) { <div class="rc-flash err">@TempData["PayError"]</div> }

    <article class="paper" id="receiptPaper">
        <span class="wm">VIBESHOOT</span>

        <header class="rc-head">
            <div class="rc-brand">
                @if (!string.IsNullOrEmpty(b.Photographer?.LogoPath))
                {
                    <img src="@b.Photographer.LogoPath" alt="" />
                }
                <div>
                    <b>VIBESHOOT</b>
                    <small>@b.Photographer?.Name</small>
                </div>
            </div>
            <div class="rc-doc">
                <div class="type">Booking Statement</div>
                <div class="no">@docNo</div>
                <div class="date">@Ui.Stamp(b.CreatedAt)</div>
                <span class="rc-status st-@Ui.Slug(b.Status)">Booking @b.Status</span>
            </div>
        </header>

        <section class="rc-cols">
            <div>
                <div class="rc-label">Billed to</div>
                <p><b>@b.ClientName</b></p>
                <p>@b.ContactNumber</p>
                @if (!string.IsNullOrWhiteSpace(b.Email)) { <p>@b.Email</p> }
                <p style="color:var(--ink-3);font-size:0.8rem;">Transaction ID: <span style="font-family:ui-monospace,Consolas,monospace;">@b.TransactionId</span></p>
            </div>
            <div>
                <div class="rc-label">Session</div>
                <p><b>@b.TargetDate.ToString("dddd, MMMM d, yyyy")</b></p>
                <p>@b.TimeRange</p>
                <p>@b.Venue</p>
                <p style="color:var(--ink-3);font-size:0.8rem;">@b.Category · @b.PackageName</p>
            </div>
        </section>

        <table class="rc-table">
            <thead><tr><th>Payment</th><th>Reference</th><th>Status</th><th class="r">Amount</th></tr></thead>
            <tbody>
                @if (!visiblePayments.Any())
                {
                    <tr><td colspan="4" style="color:var(--ink-3);">@(b.TotalPrice > 0 ? "No payments recorded yet." : "Custom package — the photographer will send you a quotation.")</td></tr>
                }
                @foreach (var pay in visiblePayments)
                {
                    <tr>
                        <td>@pay.Type<br /><small><span class="mono">@pay.ReceiptNumber</span> · @Ui.Stamp(pay.CreatedAt)</small></td>
                        <td class="mono">@pay.Method @(pay.ReferenceNumber != null ? "· " + pay.ReferenceNumber : "")</td>
                        <td>
                            <span class="rc-status st-@Ui.Slug(pay.Status)" style="margin:0;">@pay.Status</span>
                            @if (pay.Status == PaymentStatus.Rejected && !string.IsNullOrEmpty(pay.Remarks)) { <br /><small>@pay.Remarks</small> }
                        </td>
                        <td class="r">@Ui.Peso(pay.Amount)</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="rc-totals">
            @if (b.DiscountAmount > 0)
            {
                <div><span>Regular price</span><span>@Ui.Peso(b.OriginalPrice)</span></div>
                <div class="disc"><span>@(b.DiscountLabel ?? "Discount")</span><span>- @Ui.Peso(b.DiscountAmount)</span></div>
            }
            <div><span>Package price</span><span>@(b.TotalPrice > 0 ? Ui.Peso(b.TotalPrice) : "Custom")</span></div>
            <div><span>Required down payment (50%)</span><span>@Ui.Peso(b.DownPaymentRequired)</span></div>
            <div><span>Paid so far (verified)</span><span>@Ui.Peso(b.AmountPaid)</span></div>
            @if (b.AmountForVerification > 0)
            {
                <div><span>Being verified</span><span>@Ui.Peso(b.AmountForVerification)</span></div>
            }
            <div class="grand"><span>Balance due</span><span>@Ui.Peso(b.Balance)</span></div>
        </div>

        <div class="rc-note">
            @switch (b.Status)
            {
                case BookingStatus.Pending:
                    <b>What happens next?</b> <span>The photographer will verify your GCash payment and confirm your slot. Keep your Transaction ID — you can check the status anytime at <i>Track Booking</i>.</span>
                    break;
                case BookingStatus.Confirmed:
                    <b>You're booked!</b> <span>Your session is confirmed. The remaining balance is due on or before the event day (GCash or cash).</span>
                    break;
                case BookingStatus.Completed:
                    <b>Thank you!</b> <span>This session is complete. We hope you love your photos.</span>
                    break;
                default:
                    <b>This booking was @b.Status.ToLowerInvariant().</b> <span>Please contact the photographer for details.</span>
                    break;
            }
            @if (!string.IsNullOrWhiteSpace(b.AdminRemarks))
            {
                <br /><b>Note from the photographer:</b> <span>@b.AdminRemarks</span>
            }
        </div>

        <footer class="rc-foot">
            <span>Down payment is non-refundable if the client cancels. Additional hours: ₱500 (photo) / ₱1,000 (with video) per hour.</span>
            <span>Generated @Ui.Stamp(DateTime.UtcNow)</span>
        </footer>
    </article>

    @if (canPayBalance)
    {
        <form autocomplete="off" class="rc-pay" method="post" action="/booking/@b.TransactionId/pay?t=@token" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="qr"><img src="@b.Photographer!.GCashQrPath" alt="GCash QR code" /></div>
            <div>
                <h3>Pay your balance via GCash</h3>
                <p>Scan the QR, send <b style="color:#e3bf4a">@Ui.Peso(dueNow)</b>@(string.IsNullOrEmpty(b.Photographer.GCashAccountName) ? "" : $" to {b.Photographer.GCashAccountName}"), then upload your receipt below.</p>
                <label for="refNo">GCash reference no.</label>
                <input autocomplete="off" id="refNo" name="referenceNumber" inputmode="numeric" required placeholder="13-digit reference number" />
                <label for="proof">GCash receipt screenshot</label>
                <input id="proof" type="file" name="receiptImage" accept="image/*" required data-shrink />
                <button class="rc-btn gold" type="submit">Submit payment</button>
            </div>
        </form>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/shrinkImage.js" asp-append-version="true"></script>
    <script>
        // Live refresh: every 5 seconds, ask whether the booking or its payments changed and, if so,
        // swap in the updated statement (waits while the client is filling in the balance-payment form).
        (function () {
            var id = '@b.TransactionId', token = '@token';
            if (!token) return;
            var stamp = '@b.LiveStamp';     // what this page is showing right now

            function payFormBusy() {
                var form = document.querySelector('form.rc-pay');
                if (!form) return false;
                if (form.contains(document.activeElement)) return true;
                var file = form.querySelector('input[type=file]');
                var ref = form.querySelector('input[name=referenceNumber]');
                return (file && file.files.length > 0) || (ref && ref.value.trim() !== '');
            }

            function swapIn(html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var freshPaper = doc.getElementById('receiptPaper');
                if (freshPaper) document.getElementById('receiptPaper').replaceWith(freshPaper);

                var oldPay = document.querySelector('form.rc-pay'), newPay = doc.querySelector('form.rc-pay');
                if (oldPay && !newPay) oldPay.remove();
                else if (!oldPay && newPay) freshPaper.after(newPay);
                else if (oldPay && newPay) oldPay.replaceWith(newPay);
            }

            function check() {
                if (document.hidden) return;
                fetch('/booking/' + encodeURIComponent(id) + '/status?t=' + encodeURIComponent(token), { cache: 'no-store' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (s) {
                        if (!s || s.stamp === stamp || payFormBusy()) return;
                        return fetch(window.location.href, { cache: 'no-store' })
                            .then(function (r) { return r.ok ? r.text() : null; })
                            .then(function (html) {
                                if (!html) return;
                                stamp = s.stamp;
                                swapIn(html);
                                if (s.status !== 'Pending') {
                                    var card = document.getElementById('rcNotify');
                                    if (card) card.hidden = true;
                                }
                                if (window.vsBookingStatusSeen) vsBookingStatusSeen(id, s.status);
                            });
                    })
                    .catch(function () { });
            }

            check();
            setInterval(check, 5000);
            document.addEventListener('visibilitychange', check);
        })();
    </script>
    <script>
        (function () {
            var id = '@b.TransactionId', token = '@token', status = '@b.Status';
            if (!window.vsRememberBooking || !token) return;
            vsRememberBooking(id, token, status);
            vsBookingStatusSeen(id, status);             // plays "confirmed" the first time a confirmed booking is opened
            @if (paySuccess != null)
            {
                <text>vsSound('balance-sent');</text>
            }

            var card = document.getElementById('rcNotify');
            if (!card || !vsNotifySupported()) return;
            if (Notification.permission === 'granted') { vsAskNotifications(); return; }
            if (Notification.permission !== 'default') return;
            card.hidden = false;
            document.getElementById('rcNotifyBtn').addEventListener('click', function () {
                vsAskNotifications().then(function (ok) {
                    card.innerHTML = ok
                        ? '<span><b>Notifications are on.</b> Keep this page open and we will let you know.</span>'
                        : '<span>Notifications are blocked in your browser. Refresh this page anytime to see your status.</span>';
                });
            });
        })();
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        document.getElementById('btnPdf').addEventListener('click', function () {
            var btn = this;
            if (!window.html2pdf) { window.print(); return; }
            btn.disabled = true;
            html2pdf().set({
                margin: 8,
                filename: '@fileName',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            }).from(document.getElementById('receiptPaper')).save().then(function () { btn.disabled = false; });
        });
        @if (Context.Request.Query["print"] == "1")
        {
            <text>window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 400); });</text>
        }
    </script>
</body>
</html>
