@model VibeShoot.Models.PhotographerProfile
@{
    ViewData["Title"] = Model.Name;
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/About.css" asp-append-version="true" />

<div class="vs-iris-in" aria-hidden="true"></div>

<partial name="_PhotographerNav" model="@(new VibeShoot.Models.NavContext { Slug = Model.Slug, ActiveTab = "About" })" />

<div class="vs-page">
    <div class="vs-bg-layer">
        <div class="vs-bokeh"></div>
        <div class="vs-bokeh blur"></div>
        <div class="vs-bokeh"></div>
    </div>
    <div class="vs-grain"></div>
    <div class="vs-vignette"></div>

    <div class="vs-about-wrap">
        <div class="vs-about-card">
            <span class="vs-about-logo-ring">
                <img src="@Model.LogoPath" alt="@Model.Name logo" />
            </span>

            <div class="vs-about-info">
                <span class="vs-eyebrow">Photographer Profile</span>
                <h1 class="vs-about-name">@Model.Name</h1>
                <p class="vs-about-bio">@Model.Bio</p>

                <div class="vs-social-block">
                    <span class="vs-social-label">Social Media Accounts Click Here</span>
                    <div class="vs-social-row">
                        <a class="vs-social-icon" href="@Model.FacebookUrl" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                            <svg viewBox="0 0 24 24"><path d="M13.5 21v-8.2h2.75l.41-3.2h-3.16V7.4c0-.93.26-1.56 1.6-1.56h1.7V2.98A22.7 22.7 0 0 0 14.1 2.8c-2.53 0-4.26 1.54-4.26 4.37v2.43H7.1v3.2h2.74V21h3.66Z" /></svg>
                        </a>
                        <a class="vs-social-icon" href="@Model.InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                            <svg viewBox="0 0 24 24"><path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Zm0 5.8a2.3 2.3 0 1 1 0-4.6 2.3 2.3 0 0 1 0 4.6Zm4.46-6.03a.82.82 0 1 1-1.64 0 .82.82 0 0 1 1.64 0ZM12 4.9c2.4 0 2.68 0 3.63.05.88.04 1.35.19 1.67.31.42.16.72.35 1.03.66.31.31.5.61.66 1.03.12.32.27.79.31 1.67.05.95.05 1.23.05 3.63s0 2.68-.05 3.63c-.04.88-.19 1.35-.31 1.67-.16.42-.35.72-.66 1.03-.31.31-.61.5-1.03.66-.32.12-.79.27-1.67.31-.95.05-1.23.05-3.63.05s-2.68 0-3.63-.05c-.88-.04-1.35-.19-1.67-.31a2.77 2.77 0 0 1-1.03-.66 2.77 2.77 0 0 1-.66-1.03c-.12-.32-.27-.79-.31-1.67C4.65 14.68 4.65 14.4 4.65 12s0-2.68.05-3.63c.04-.88.19-1.35.31-1.67.16-.42.35-.72.66-1.03.31-.31.61-.5 1.03-.66.32-.12.79-.27 1.67-.31C9.32 4.9 9.6 4.9 12 4.9Zm0-1.62c-2.44 0-2.74.01-3.7.06-.96.04-1.62.2-2.2.42-.6.23-1.1.55-1.61 1.05-.5.5-.82 1.01-1.05 1.61-.22.58-.38 1.24-.42 2.2-.05.96-.06 1.26-.06 3.7s.01 2.74.06 3.7c.04.96.2 1.62.42 2.2.23.6.55 1.1 1.05 1.61.5.5 1.01.82 1.61 1.05.58.22 1.24.38 2.2.42.96.05 1.26.06 3.7.06s2.74-.01 3.7-.06c.96-.04 1.62-.2 2.2-.42.6-.23 1.1-.55 1.61-1.05.5-.5.82-1.01 1.05-1.61.22-.58.38-1.24.42-2.2.05-.96.06-1.26.06-3.7s-.01-2.74-.06-3.7c-.04-.96-.2-1.62-.42-2.2a4.4 4.4 0 0 0-1.05-1.61 4.4 4.4 0 0 0-1.61-1.05c-.58-.22-1.24-.38-2.2-.42-.96-.05-1.26-.06-3.7-.06Z" /></svg>
                        </a>
                        <a class="vs-social-icon" href="@Model.TikTokUrl" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                            <svg viewBox="0 0 24 24"><path d="M16.5 3h-2.8v11.9a2.6 2.6 0 1 1-1.85-2.49v-2.87a5.47 5.47 0 1 0 4.65 5.4V9.1a7.6 7.6 0 0 0 4.3 1.34V7.6a4.85 4.85 0 0 1-4.3-4.6Z" /></svg>
                        </a>
                        <a class="vs-social-icon" href="@Model.XUrl" target="_blank" rel="noopener noreferrer" aria-label="X">
                            <svg viewBox="-3 -3 30 30"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.847h-7.406l-5.8-7.584-6.64 7.584H.47l8.6-9.83L0 1.153h7.594l5.243 6.932z" /></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>