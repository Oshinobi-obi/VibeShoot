@model VibeShoot.Models.NavContext

<link rel="stylesheet" href="~/css/Navbar.css" asp-append-version="true" />

<nav class="vs-navbar">
    <a class="vs-nav-brand" href="/photographers">VibeShoot</a>
    <div class="vs-nav-links">
        <a class="vs-nav-link @(Model.ActiveTab == "About" ? "active" : "")"
           href="/photographer/@Model.Slug/about">About</a>
        <a class="vs-nav-link @(Model.ActiveTab == "Album" ? "active" : "")"
           href="/photographer/@Model.Slug/album">Album</a>
        <a class="vs-nav-link @(Model.ActiveTab == "Schedule" ? "active" : "")"
           href="/photographer/@Model.Slug/schedule">Schedule</a>
    </div>
    <span></span>
</nav>

<div class="vs-nav-iris" id="navIris" aria-hidden="true"></div>
<script src="~/js/Navbar.js" asp-append-version="true"></script>