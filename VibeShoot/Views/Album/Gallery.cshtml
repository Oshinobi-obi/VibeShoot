@using System.Linq
@model VibeShoot.Models.AlbumViewModel
@{
    ViewData["Title"] = Model.Name;
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Album.css" asp-append-version="true" />
}

<div class="vs-iris-in" aria-hidden="true"></div>

<partial name="_PhotographerNav" model="@(new VibeShoot.Models.NavContext { Slug = Model.Slug, ActiveTab = "Album" })" />

<div class="vs-page">
    <div class="vs-bg-layer">
        <div class="vs-bokeh"></div>
        <div class="vs-bokeh blur"></div>
        <div class="vs-bokeh"></div>
    </div>
    <div class="vs-grain"></div>
    <div class="vs-vignette"></div>

    <div class="vs-gallery-wrap">
        <span class="vs-eyebrow">Photographer Gallery</span>
        <div class="vs-gallery-header">
            <span class="vs-mini-logo">
                <img src="@Model.LogoPath" alt="@Model.Name logo" />
            </span>
            <h1 class="vs-gallery-title">@Model.Name</h1>
        </div>

        <div class="vs-tabs">
            @for (int t = 0; t < Model.Categories.Count; t++)
            {
                var cat = Model.Categories[t];
                <button type="button" class="vs-tab @(t == 0 ? "active" : "")" data-target="@cat.Slug">@cat.Name</button>
            }
        </div>

        <div class="vs-panels">
            @foreach (var cat in Model.Categories)
            {
                var isFirst = cat == Model.Categories[0];
                <div class="vs-panel @(isFirst ? "active" : "")" data-category="@cat.Slug">
                    @if (cat.ImageUrls.Count == 0)
                    {
                        <p class="vs-empty">No @cat.Name.ToLower() photos yet — check back soon.</p>
                    }
                    else if (cat.ImageUrls.Count <= 5)
                    {
                        <div class="vs-photo-grid">
                            @for (int i = 0; i < cat.ImageUrls.Count; i++)
                            {
                                <div class="vs-photo-thumb" data-category="@cat.Slug" data-index="@i" style="--stagger-idx: @i;" tabindex="0" role="button" aria-label="Open @cat.Name photo @(i + 1)">
                                    <img src="@cat.ImageUrls[i]" alt="@Model.Name @cat.Name photo @(i + 1)" loading="lazy" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="vs-carousel">
                            <button type="button" class="vs-carousel-btn" data-dir="prev" aria-label="Scroll @cat.Name photos left">
                                <svg viewBox="0 0 24 24"><path d="M14.7 5.3 8 12l6.7 6.7 1.4-1.4L10.8 12l5.3-5.3z" /></svg>
                            </button>
                            <div class="vs-carousel-track">
                                <div class="vs-carousel-inner">
                                    @for (int i = 0; i < cat.ImageUrls.Count; i++)
                                    {
                                        <div class="vs-photo-thumb" data-category="@cat.Slug" data-index="@i" style="--stagger-idx: @i;" tabindex="0" role="button" aria-label="Open @cat.Name photo @(i + 1)">
                                            <img src="@cat.ImageUrls[i]" alt="@Model.Name @cat.Name photo @(i + 1)" loading="lazy" />
                                        </div>
                                    }
                                </div>
                            </div>
                            <button type="button" class="vs-carousel-btn" data-dir="next" aria-label="Scroll @cat.Name photos right">
                                <svg viewBox="0 0 24 24"><path d="M9.3 5.3 16 12l-6.7 6.7-1.4-1.4L13.2 12 7.9 6.7z" /></svg>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="vs-lightbox" id="vsLightbox" aria-hidden="true">
    <div class="vs-lightbox-frame">
        <button type="button" class="vs-lightbox-close" id="vsLightboxClose" aria-label="Close">&times;</button>
        <button type="button" class="vs-lightbox-nav vs-lightbox-prev" id="vsLightboxPrev" aria-label="Previous photo">
            <svg viewBox="0 0 24 24"><path d="M14.7 5.3 8 12l6.7 6.7 1.4-1.4L10.8 12l5.3-5.3z" /></svg>
        </button>
        <img id="vsLightboxImg" src="" alt="" />
        <button type="button" class="vs-lightbox-nav vs-lightbox-next" id="vsLightboxNext" aria-label="Next photo">
            <svg viewBox="0 0 24 24"><path d="M9.3 5.3 16 12l-6.7 6.7-1.4-1.4L13.2 12 7.9 6.7z" /></svg>
        </button>
    </div>
</div>

@section Scripts {
    <script>
        var vsGalleryData = {
            @foreach (var cat in Model.Categories)
            {
                    @:"@cat.Slug": [@Html.Raw(string.Join(",", cat.ImageUrls.Select(u => "\"" + u + "\"")))],
            }
        };
    </script>
    <script src="~/js/Album.js" asp-append-version="true"></script>
}